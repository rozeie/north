# ── 인증 (Google OAuth) ─────────────────────────────
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID(웹 애플리케이션)
# 승인된 리디렉션 URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 세션 암호화 키. 예: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── AI (선택) ─────────────────────────────────────
# 비워두면 mock AI(규칙 기반 샘플 응답)로 동작한다.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# ── 개발 전용 ─────────────────────────────────────
# true 이면 Google 설정 없이 "개발용 로그인" 버튼이 나타난다. production 빌드에서는 항상 무시된다.
DEV_AUTH_BYPASS=false

# ── 분석 (Mixpanel, 선택) ─────────────────────────
# 비워두면 이벤트를 전송하지 않는다.
NEXT_PUBLIC_MIXPANEL_TOKEN=
